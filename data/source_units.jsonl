{"unit_id": "S4A-2026-000", "section": "document_title", "source_text_en": "Supportive and Palliative Care Indicators Tool (SPICT-4ALL-……)", "source_text_sha256": "e0d92d4423ed4dd44c3905348ccb15531f9d0d8635b6d9e3e6aed8f7d5977a79", "source_location": {"visual_reference": "page header / template title"}, "source_style": "title", "translation_status": "AUTHORITY_DECISION_REQUIRED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-001", "section": "intro", "source_text_en": "The SPICT helps us look for people who have life shortening health conditions and are less well. These people need more help and care now, and a plan for care in the future.", "source_text_sha256": "073f41ea2df0103ff84d71ac3bf63cdbc88ed4ce579604fbbac10aea11652aac", "source_location": {"table_index": 0, "row": 1, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-002", "section": "general_indicators", "source_text_en": "Does this person have signs of poor health or health problems that are getting worse?", "source_text_sha256": "4e2ea44a5cb6778dfe05cadc1c17810b91e4e245ac7d2d9f0eb869b523fb452d", "source_location": {"table_index": 0, "row": 3, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-003", "section": "general_indicators", "source_text_en": "Urgent or emergency hospital admission(s) or visits.", "source_text_sha256": "e0833c16f94535ce3009a1737201e39f1b822baa1447edbc35b6f8a37a6d756a", "source_location": {"table_index": 0, "row": 5, "column": 0, "paragraph": 0}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-004", "section": "general_indicators", "source_text_en": "Less able to manage usual activities; not as well as they used to be.\n(Person often stays in bed or in a chair for more than half the day.)", "source_text_sha256": "e2a76846cca5d053af8161133c81edddbe40529b37fde2bfde986af56ce60c3c", "source_location": {"table_index": 0, "row": 7, "column": 0, "paragraph": 0}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-005", "section": "general_indicators", "source_text_en": "Needs more help and care from others due to increasing physical and/or mental health problems.", "source_text_sha256": "fdcefa0555355b1ced3795bd3b6068b5a351d4a7f2498a9d6b941094a3606f21", "source_location": {"table_index": 0, "row": 9, "column": 0, "paragraph": 0}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-006", "section": "general_indicators", "source_text_en": "Person’s carer needs more help and support.", "source_text_sha256": "ecdb4474294eb1f6797305ec921a2f58658b85ca3875d9e639de4ccb3e322601", "source_location": {"table_index": 0, "row": 9, "column": 0, "paragraph": 1}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-007", "section": "general_indicators", "source_text_en": "Has clearly lost weight over the last few months; or stays too thin.", "source_text_sha256": "7181dd9f28e654ec269bda2ff32da7c18405eca65e4969279686e38741064214", "source_location": {"table_index": 0, "row": 11, "column": 0, "paragraph": 0}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-008", "section": "general_indicators", "source_text_en": "Has troublesome symptoms most of the time despite good treatment of their health problems.", "source_text_sha256": "4001d97a18450bfb36e8eaf191283f8cceccbbe86bbd1d331d9e74621a7d8eb7", "source_location": {"table_index": 0, "row": 13, "column": 0, "paragraph": 0}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-009", "section": "general_indicators", "source_text_en": "The person (or family) asks for palliative care; chooses to reduce, stop or not have treatment; or wishes to focus on quality of life.", "source_text_sha256": "792e53797023341c64f79e3598752320b23375c8bc346e14dd6906e003362f29", "source_location": {"table_index": 0, "row": 15, "column": 0, "paragraph": 0}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-010", "section": "health_problem_prompt", "source_text_en": "Does this person have any of these health problems?", "source_text_sha256": "91aa0e8b9dd807ae79c1ed0d573e0faf66910befda4681cae6c821e8e5687c6b", "source_location": {"table_index": 0, "row": 17, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-011", "section": "cancer", "source_text_en": "Cancer", "source_text_sha256": "f2c28b5295d9ad14e2e24f8467e0dab646338858d7f11d5267b094e875e36edb", "source_location": {"table_index": 0, "row": 19, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-012", "section": "heart_or_circulation", "source_text_en": "Heart or circulation problems", "source_text_sha256": "96483c2d15c955cd20a7e3f77f7cfe11675e57abac2b8253523ca7f90a49f219", "source_location": {"table_index": 0, "row": 19, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-013", "section": "kidney", "source_text_en": "Kidney problems", "source_text_sha256": "268f55cc97dd320e421d37a95d15154fe7a9996c5eac7349e37b35a9a2ff388d", "source_location": {"table_index": 0, "row": 19, "column": 2, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-014", "section": "cancer", "source_text_en": "Less able to manage usual activities and health is getting poorer.", "source_text_sha256": "99fde2e084601e17d09b4d21f6fd5332555634a614361a9d6df4299582c02fbb", "source_location": {"table_index": 0, "row": 21, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-015", "section": "heart_or_circulation", "source_text_en": "Heart failure or heart blood vessel disease. Short of breath or has chest pain when resting, moving or walking a few steps.", "source_text_sha256": "a2033df46c00ed0fa3eaae26c5185127d715d9f8a71db3b98965ac006919465c", "source_location": {"table_index": 0, "row": 21, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-016", "section": "kidney", "source_text_en": "Kidneys are not working well; general health is getting poorer.", "source_text_sha256": "caf76353b40f44135d84633d46d756043db126bfd293f6b08f0902384e619f1b", "source_location": {"table_index": 0, "row": 21, "column": 2, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-017", "section": "cancer", "source_text_en": "Not well enough for cancer treatment or treatment is to help with symptoms.", "source_text_sha256": "9206d4bd4125ed5c6ef1006bbbe74035d8c4ee3021400d0bcaf06ab0908a552f", "source_location": {"table_index": 0, "row": 23, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-018", "section": "heart_or_circulation", "source_text_en": "Leg problems due to poor blood circulation; surgery is not possible.", "source_text_sha256": "058b7cb6ee5a40a7d514f92acad1533f77a63576601024e2667ffc02e6aea25f", "source_location": {"table_index": 0, "row": 23, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-019", "section": "kidney", "source_text_en": "Stopping kidney dialysis or choosing palliative care instead of starting dialysis.", "source_text_sha256": "2b7fddfeb4727487c69bcfde27c5f60a91c1e74206c30068035e330753f18303", "source_location": {"table_index": 0, "row": 23, "column": 2, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-020", "section": "kidney", "source_text_en": "Stopping or not starting dialysis", "source_text_sha256": "8ce559219ef352629369543d5a95eeae1d37c880c65715511d69634ae6eefcb2", "source_location": {"table_index": 0, "row": 25, "column": 2, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-021", "section": "dementia_or_frailty", "source_text_en": "Dementia or frailty", "source_text_sha256": "ae652fc158e53bfb5c9b52b9c94f57696f0d433f2240c5345a6d99b48ba02f73", "source_location": {"table_index": 0, "row": 27, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-022", "section": "respiratory", "source_text_en": "Respiratory problems", "source_text_sha256": "fd5a7429de80300bad8e049546d350e782e81952420927c1e487b0d285007c11", "source_location": {"table_index": 0, "row": 27, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-023", "section": "liver", "source_text_en": "Liver problems", "source_text_sha256": "2008353ef1fa350f45f0267d8e2116677fce16728e66b811230748faa8400728", "source_location": {"table_index": 0, "row": 27, "column": 2, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-024", "section": "dementia_or_frailty", "source_text_en": "Unable to dress, walk or eat without help.", "source_text_sha256": "b946f5676d14ac3e69ba2303043942ee4e09a1da960a77735c4aedc09e3bc02e", "source_location": {"table_index": 0, "row": 29, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-025", "section": "respiratory", "source_text_en": "More unwell with long term lung problems. Short of breath when resting, moving or walking a few steps even when the chest is at its best.", "source_text_sha256": "4370111602ffcff5b4b2fe5b501df2b001b5424b4813493a605dacc5e6472802", "source_location": {"table_index": 0, "row": 29, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-026", "section": "liver", "source_text_en": "Worsening liver problems in the past year with complications like:", "source_text_sha256": "af527f00432f81a06cb3f05cdda159821b786bc73318c0fb577f55eac57dc04e", "source_location": {"table_index": 0, "row": 29, "column": 2, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-027", "section": "liver", "source_text_en": "fluid building up in the belly", "source_text_sha256": "adb8720dd5159892938a27769ffa7b771bd1f74d02cc3bb4922751f115123f94", "source_location": {"table_index": 0, "row": 29, "column": 2, "paragraph": 1}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-028", "section": "liver", "source_text_en": "being confused at times", "source_text_sha256": "893dc30e9dbb7c7b6604094e6b3b32e28d57e18d24b141b094f8f05995c6ea34", "source_location": {"table_index": 0, "row": 29, "column": 2, "paragraph": 2}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-029", "section": "liver", "source_text_en": "kidneys not working well", "source_text_sha256": "7ee57d9b958f5eed889774298637a6a7646c7b7d671773f8a9abad9e3d20ccae", "source_location": {"table_index": 0, "row": 29, "column": 2, "paragraph": 3}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-030", "section": "liver", "source_text_en": "infections", "source_text_sha256": "f7c719ccac9bfcb69d5a06bb091cce53a8f48edc8f55a49e92418e5a0ef1bcf4", "source_location": {"table_index": 0, "row": 29, "column": 2, "paragraph": 4}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-031", "section": "liver", "source_text_en": "bleeding from the gullet", "source_text_sha256": "d00a673e4350880f79ceb91ca8b1c89ebc9421e549a5c3b10de2d3452237baa7", "source_location": {"table_index": 0, "row": 29, "column": 2, "paragraph": 5}, "source_style": "List Paragraph", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-032", "section": "dementia_or_frailty", "source_text_en": "Eating and drinking less; difficulty with swallowing.", "source_text_sha256": "b5543801f73cb501f54de194003f7d5fee207839b814601958e703045193e220", "source_location": {"table_index": 0, "row": 31, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-033", "section": "respiratory", "source_text_en": "Needs to use oxygen for much of the day and night.", "source_text_sha256": "16b7ffb4566568735f445007a90b206e7051187169f0a14d5c2302ffb1c6fc79", "source_location": {"table_index": 0, "row": 31, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-034", "section": "dementia_or_frailty", "source_text_en": "Has poor control of bladder and bowels.", "source_text_sha256": "ee85bfdd3adc62c869acaa94fca31314a483269c0459128809a2dc1ba3199063", "source_location": {"table_index": 0, "row": 33, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-035", "section": "respiratory", "source_text_en": "Has needed treatment with a breathing machine in hospital.", "source_text_sha256": "03dc5cede7282aba176529d454a95cc5428d817357dbffc5dbaaaa5c9262cb81", "source_location": {"table_index": 0, "row": 33, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-036", "section": "dementia_or_frailty", "source_text_en": "Not able to communicate by speaking; not responding much to other people.", "source_text_sha256": "69688aa05b30b967ed5ed973c91cae039d2ff3f7130f894e0184addb81c60884", "source_location": {"table_index": 0, "row": 35, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-037", "section": "dementia_or_frailty", "source_text_en": "Frequent falls; fractured femur.", "source_text_sha256": "96324a612d8a141623f99119fea92e7043689d4744fe0d6bbead80d2cd8aa182", "source_location": {"table_index": 0, "row": 37, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-038", "section": "dementia_or_frailty", "source_text_en": "Frequent infections; pneumonia", "source_text_sha256": "99ecdde88af547bde3129601476f3b323e511474ef069349752fe59866e61df8", "source_location": {"table_index": 0, "row": 39, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-039", "section": "nervous_system", "source_text_en": "Nervous system problems", "source_text_sha256": "5c3d417084d24c372a80dcc69467cc7d378715635bedd894b9bcbc3369dc071e", "source_location": {"table_index": 0, "row": 41, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-040", "section": "other_conditions_and_actions", "source_text_en": "Other conditions", "source_text_sha256": "76be1cc7c5b8be144dbd59555fa0b57a080e2e7bcbeedb0845e61c69a1fb0c0a", "source_location": {"table_index": 0, "row": 41, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-041", "section": "nervous_system", "source_text_en": "Physical and mental health are getting worse.", "source_text_sha256": "c0da68998a98e8a4b62feac9d288b1324608a923e07936e501368f525b478fa9", "source_location": {"table_index": 0, "row": 43, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-042", "section": "other_conditions_and_actions", "source_text_en": "People who are less well with other life shortening physical or mental illnesses or health conditions. There is no treatment available or it will not work well.", "source_text_sha256": "d19219bbd6660dba90264b527df0573d44b9374e279181ff43baa7592d8d1169", "source_location": {"table_index": 0, "row": 43, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-043", "section": "nervous_system", "source_text_en": "More problems with speaking and communicating; swallowing is getting worse.", "source_text_sha256": "9fe2e73f548c64d0fd73941103a61bd789543c15a871c027617567cea69c7dbe", "source_location": {"table_index": 0, "row": 45, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-044", "section": "other_conditions_and_actions", "source_text_en": "What we can do to help this person and their family.", "source_text_sha256": "3de4716eb33b41c98155657b801a05859fefe5fda817a3744076e38e39ab74d5", "source_location": {"table_index": 0, "row": 45, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-045", "section": "nervous_system", "source_text_en": "Chest infections or pneumonia; breathing problems.", "source_text_sha256": "e6f4042ff1dd7f0560ebe0676573b533335874aa799c08b7701a94b72bcbf75d", "source_location": {"table_index": 0, "row": 47, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-046", "section": "other_conditions_and_actions", "source_text_en": "Start talking with the person and their family or carer about help needed now and why making plans is important in case things change.", "source_text_sha256": "fc1e70c2a5d6055d43bd6e968d068c53e30374d1c0f46ff989b1d85d18584bd6", "source_location": {"table_index": 0, "row": 47, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-047", "section": "nervous_system", "source_text_en": "Ongoing disability with increasing physical and/or mental health problems after one or more strokes.", "source_text_sha256": "f3cb22010d9566918b33bf98f2e3bbd44976fe1c2a638f3d561a2c8cb3c36d37", "source_location": {"table_index": 0, "row": 49, "column": 0, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-048", "section": "other_conditions_and_actions", "source_text_en": "Ask for help and advice from a nurse, doctor, social worker or other staff if the person or family needs a review of their care and support.", "source_text_sha256": "88456f1d645cbb8c2b727c914d1aea3db6974b82608a1d99c43f68ac4868bff8", "source_location": {"table_index": 0, "row": 49, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-049", "section": "care_actions", "source_text_en": "We look at the person’s medicines and other treatments to give the best care. Holistic care includes symptoms, emotional, social, functional, financial, spiritual, cultural problems.", "source_text_sha256": "bbf8762a42a6a44aacc9121173ad6e4c5578384ec72e3f25ebee38e11f6be4f3", "source_location": {"table_index": 0, "row": 51, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
{"unit_id": "S4A-2026-050", "section": "care_actions", "source_text_en": "Ask for specialist help if symptoms or problems are difficult to manage.", "source_text_sha256": "ea006ba91f098733a23dacdda2893c980aabebc7414528de20a2ec009d628520", "source_location": {"table_index": 0, "row": 53, "column": 1, "paragraph": 0}, "source_style": "Normal", "translation_status": "UNTRANSLATED", "target_fi": "", "requires_human_signoff": true}
