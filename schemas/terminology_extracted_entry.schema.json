{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extracted terminology evidence entry",
  "type": "object",
  "required": [
    "entry_id",
    "term_fi",
    "term_en",
    "term_en_origin",
    "definition",
    "context",
    "source_id",
    "source_filename",
    "source_sha256",
    "source_location",
    "source_organisation",
    "source_date_version",
    "extraction_method",
    "source_fragment",
    "source_provided_fields",
    "project_interpretation",
    "approval_status",
    "notes"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "pattern": "^TERM-EVID-[A-Z0-9-]+$"
    },
    "term_fi": {
      "type": "string",
      "minLength": 1
    },
    "term_en": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "term_en_origin": {
      "enum": [
        "SOURCE_EXPLICIT",
        "NOT_PROVIDED"
      ]
    },
    "definition": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "context": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "pattern": "^TERM-SRC-[0-9]{3}$"
    },
    "source_filename": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_location": {
      "type": "object",
      "required": [
        "kind",
        "number"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CSV_ROW",
            "PDF_PAGE"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "source_record_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "source_organisation": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_date_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 4
    },
    "extraction_method": {
      "enum": [
        "CSV_EXPLICIT_COLUMN_EXTRACTION",
        "PDF_EXACT_FRAGMENT_RULE"
      ]
    },
    "source_fragment": {
      "type": "string",
      "minLength": 1
    },
    "source_provided_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "term_fi",
          "term_en",
          "definition",
          "context"
        ]
      },
      "uniqueItems": true
    },
    "project_interpretation": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_status": {
      "const": "DISCOVERED"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "term_en_origin": {
            "const": "SOURCE_EXPLICIT"
          }
        }
      },
      "then": {
        "required": [
          "term_en"
        ],
        "properties": {
          "term_en": {
            "type": "string",
            "minLength": 1
          },
          "source_provided_fields": {
            "contains": {
              "const": "term_en"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "term_en_origin": {
            "const": "NOT_PROVIDED"
          }
        }
      },
      "then": {
        "properties": {
          "term_en": {
            "type": "null"
          },
          "source_provided_fields": {
            "not": {
              "contains": {
                "const": "term_en"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
