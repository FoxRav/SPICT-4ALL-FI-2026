{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPICT-4ALL Translation Candidate",
  "type": "object",
  "required": [
    "unit_id",
    "source_text_sha256",
    "model",
    "candidate_fi",
    "decision_note",
    "issues",
    "status"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "pattern": "^(S4A-2026-[0-9]{3}|S4A-REQ-[0-9]{4}-[0-9]{3})$"
    },
    "source_text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "candidate_fi": {
      "type": "string"
    },
    "decision_note": {
      "type": "string",
      "description": "Concise auditable note; not private chain-of-thought."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "NOTE"
            ]
          },
          "type": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "type",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "BLOCKED",
        "READY_FOR_SYNTHESIS",
        "READY_FOR_HUMAN_REVIEW",
        "HUMAN_APPROVED",
        "HUMAN_REJECTED"
      ]
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced forward-compatibility container. Nothing inside it carries approval, gate, review or document-insertion authority."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "READY_FOR_SYNTHESIS",
              "READY_FOR_HUMAN_REVIEW",
              "HUMAN_APPROVED",
              "HUMAN_REJECTED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "candidate_fi"
        ],
        "properties": {
          "candidate_fi": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
